+/* returns FALSE when the surfaces are not plain 32bpp at exactly 2x, so the caller falls back to StretchBlt */
+static BOOL xbr_flush( struct window_surface *window_surface, struct window_surface *target, const RECT *src_rect,
+                       const RECT *dst_rect, const BITMAPINFO *color_info, const void *color_bits )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *tinfo = (BITMAPINFO *)buffer;
+    const BITMAPINFOHEADER *sh = &color_info->bmiHeader;
+    RECT rect = *src_rect;
+    UINT *tbits;
+    int sw, shh, tw, th;
+
+    if (window_surface->alpha_mask || !color_bits) return FALSE;
+    if (dst_rect->right - dst_rect->left != 2 * (src_rect->right - src_rect->left)) return FALSE;
+    if (dst_rect->bottom - dst_rect->top != 2 * (src_rect->bottom - src_rect->top)) return FALSE;
+    if (dst_rect->left != 2 * src_rect->left || dst_rect->top != 2 * src_rect->top) return FALSE;
+    if (sh->biBitCount != 32 || sh->biHeight >= 0) return FALSE;
+    if (!(tbits = window_surface_get_color( target, tinfo ))) return FALSE;
+    if (tinfo->bmiHeader.biBitCount != 32 || tinfo->bmiHeader.biHeight >= 0) return FALSE;
+
+    sw = sh->biWidth;
+    shh = -sh->biHeight;
+    tw = tinfo->bmiHeader.biWidth;
+    th = -tinfo->bmiHeader.biHeight;
+    rect.right = min( min( rect.right, sw ), tw / 2 );
+    rect.bottom = min( min( rect.bottom, shh ), th / 2 );
+    rect.left = max( rect.left, 0 );
+    rect.top = max( rect.top, 0 );
+    if (rect.left >= rect.right || rect.top >= rect.bottom) return TRUE;
+
+    window_surface_lock( target );
+    xbr_scale2x( color_bits, sw, shh, sw, tbits, tw, &rect );
+    window_surface_unlock( target );
+    return TRUE;
+}

+static void METAFILE_AdjustFrameWorldPoints(GpMetafile *metafile, GpPointF *points, int num_points)
+{
+    if (!metafile->auto_frame || !metafile->record_graphics)
+        return;
+
+    GdipTransformPoints(metafile->record_graphics, CoordinateSpaceDevice,
+        CoordinateSpaceWorld, points, num_points);
+    METAFILE_AdjustFrame(metafile, points, num_points);
+}
+
+static void METAFILE_AdjustFrameRect(GpMetafile *metafile, const GpRectF *rect, REAL inflate)
+{
+    GpPointF corners[4];
+
+    corners[0].X = rect->X - inflate;
+    corners[0].Y = rect->Y - inflate;
+    corners[1].X = rect->X + rect->Width + inflate;
+    corners[1].Y = corners[0].Y;
+    corners[2].X = corners[0].X;
+    corners[2].Y = rect->Y + rect->Height + inflate;
+    corners[3].X = corners[1].X;
+    corners[3].Y = corners[2].Y;
+
+    METAFILE_AdjustFrameWorldPoints(metafile, corners, 4);
+}
+
+static REAL METAFILE_PenInflate(const GpPen *pen)
+{
+    return pen ? max(pen->width, 1.0f) / 2.0f + 1.0f : 0.0f;
+}
+
+static void METAFILE_AdjustFramePath(GpMetafile *metafile, GpPath *path, GpPen *pen)
+{
+    GpRectF rect;
+
+    if (!metafile->auto_frame || !metafile->record_graphics)
+        return;
+
+    if (GdipGetPathWorldBounds(path, &rect, NULL, NULL) == Ok)
+        METAFILE_AdjustFrameRect(metafile, &rect, METAFILE_PenInflate(pen));
+}

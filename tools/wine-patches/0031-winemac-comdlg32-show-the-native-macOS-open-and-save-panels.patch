+static CFStringRef cfstring_from_wstr(const WCHAR *str)
+{
+    size_t len = 0;
+
+    if (!str) return NULL;
+    while (str[len]) len++;
+    return CFStringCreateWithCharacters(NULL, (const UniChar *)str, len);
+}
+
+static NTSTATUS macdrv_file_dialog_start_call(void *arg)
+{
+    struct file_dialog_start_params *params = arg;
+    CFMutableArrayRef names = CFArrayCreateMutable(NULL, 0, &kCFTypeArrayCallBacks);
+    CFMutableArrayRef specs = CFArrayCreateMutable(NULL, 0, &kCFTypeArrayCallBacks);
+    CFStringRef title = cfstring_from_wstr(param_ptr(params->title));
+    CFStringRef prompt = cfstring_from_wstr(param_ptr(params->prompt));
+    CFStringRef name = cfstring_from_wstr(param_ptr(params->name));
+    CFStringRef dir = NULL;
+    const WCHAR *filter = param_ptr(params->filters);
+    UINT i;
+
+    if (params->unix_dir)
+        dir = CFStringCreateWithCString(NULL, param_ptr(params->unix_dir), kCFStringEncodingUTF8);
+
+    for (i = 0; filter && i < params->filter_count; i++)
+    {
+        CFStringRef str = cfstring_from_wstr(filter);
+        CFArrayAppendValue(names, str);
+        CFRelease(str);
+        while (*filter) filter++;
+        filter++;
+
+        str = cfstring_from_wstr(filter);
+        CFArrayAppendValue(specs, str);
+        CFRelease(str);
+        while (*filter) filter++;
+        filter++;
+    }
+
+    params->handle = (UINT_PTR)macdrv_file_dialog_start(params->flags, title, prompt, dir, name, names, specs,
+                                                        params->filter_index);
+
+    if (title) CFRelease(title);
+    if (prompt) CFRelease(prompt);
+    if (name) CFRelease(name);
+    if (dir) CFRelease(dir);
+    CFRelease(names);
+    CFRelease(specs);
+    return params->handle ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+}
+
+static NTSTATUS macdrv_file_dialog_result_call(void *arg)
+{
+    struct file_dialog_result_params *params = arg;
+    macdrv_file_dialog dialog = param_ptr(params->handle);
+
+    params->status = macdrv_file_dialog_status(dialog);
+    params->needed = 0;
+    if (params->status == MACDRV_FILE_DIALOG_OK)
+        params->needed = macdrv_file_dialog_result(dialog, param_ptr(params->buffer), params->size,
+                                                   &params->filter_index);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS macdrv_file_dialog_close_call(void *arg)
+{
+    struct file_dialog_close_params *params = arg;
+    macdrv_file_dialog_close(param_ptr(params->handle));
+    return STATUS_SUCCESS;
+}

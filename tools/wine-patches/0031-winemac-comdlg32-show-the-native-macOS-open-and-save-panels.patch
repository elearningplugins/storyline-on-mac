+#define MAC_FILE_DIALOG_SAVE         0x1
+#define MAC_FILE_DIALOG_MULTISELECT  0x2
+#define MAC_FILE_DIALOG_FOLDERS      0x4
+#define MAC_FILE_DIALOG_HIDDEN       0x8
+#define MAC_FILE_DIALOG_PENDING      0
+#define MAC_FILE_DIALOG_OK           1
+
+struct mac_file_dialog_funcs
+{
+    UINT64 (CDECL *show)(UINT, const WCHAR *, const WCHAR *, const char *, const WCHAR *, const WCHAR *, UINT, UINT);
+    UINT (CDECL *result)(UINT64, char *, UINT, UINT *, UINT *);
+    void (CDECL *close)(UINT64);
+};
+
+static BOOL get_mac_file_dialog_funcs(FileDialogImpl *This, struct mac_file_dialog_funcs *funcs)
+{
+    HMODULE module = GetModuleHandleW(L"winemac.drv");
+    WCHAR env[8];
+
+    if (!module || !list_empty(&This->cctrls) || This->hmenu_opendropdown) return FALSE;
+    if (GetEnvironmentVariableW(L"WINE_MAC_FILE_DIALOGS", env, ARRAY_SIZE(env)) && !wcscmp(env, L"0"))
+        return FALSE;
+
+    funcs->show = (void *)GetProcAddress(module, "wine_file_dialog_show");
+    funcs->result = (void *)GetProcAddress(module, "wine_file_dialog_result");
+    funcs->close = (void *)GetProcAddress(module, "wine_file_dialog_close");
+    return funcs->show && funcs->result && funcs->close;
+}
+
+static char *get_mac_start_dir(FileDialogImpl *This)
+{
+    IShellItem *folder = This->psi_setfolder ? This->psi_setfolder : This->psi_defaultfolder;
+    WCHAR *path;
+    char *unix_path = NULL;
+
+    if (folder && SUCCEEDED(IShellItem_GetDisplayName(folder, SIGDN_FILESYSPATH, &path)))
+    {
+        unix_path = wine_get_unix_file_name(path);
+        CoTaskMemFree(path);
+    }
+    return unix_path;
+}
+
+static WCHAR *get_mac_filters(FileDialogImpl *This)
+{
+    WCHAR *filters, *pos;
+    UINT i, len = 1;
+
+    for (i = 0; i < This->filterspec_count; i++)
+        len += lstrlenW(This->filterspecs[i].pszName) + lstrlenW(This->filterspecs[i].pszSpec) + 2;
+    if (!(pos = filters = malloc(len * sizeof(WCHAR)))) return NULL;
+
+    for (i = 0; i < This->filterspec_count; i++)
+    {
+        lstrcpyW(pos, This->filterspecs[i].pszName);
+        pos += lstrlenW(pos) + 1;
+        lstrcpyW(pos, This->filterspecs[i].pszSpec);
+        pos += lstrlenW(pos) + 1;
+    }
+    *pos = 0;
+    return filters;
+}
+
+/* Turns the panel's UTF-8 paths into results the way on_default_action does for the Wine dialog, then asks the app through OnFileOk */
+static HRESULT set_mac_results(FileDialogImpl *This, const char *paths, UINT filter_index)
+{
+    IShellFolder *psf_desktop;
+    IShellItem *item;
+    LPITEMIDLIST *pidla;
+    const char *path;
+    UINT count = 0, i;
+    BOOL appended = FALSE;
+    HRESULT hr;
+
+    for (path = paths; *path; path += strlen(path) + 1) count++;
+    if (!count || !(pidla = calloc(count, sizeof(*pidla)))) return E_FAIL;
+
+    if (This->filterspec_count)
+    {
+        This->filetypeindex = min(filter_index, This->filterspec_count - 1);
+        set_current_filter(This, This->filterspecs[This->filetypeindex].pszSpec);
+    }
+
+    for (i = 0, path = paths; *path; path += strlen(path) + 1)
+    {
+        WCHAR *dos_path = wine_get_dos_file_name(path), filename[MAX_PATH], extbuf[MAX_PATH], *newext = NULL;
+
+        if (!dos_path) continue;
+        lstrcpynW(filename, dos_path, MAX_PATH);
+        HeapFree(GetProcessHeap(), 0, dos_path);
+
+        if (This->dlg_type == ITEMDLG_TYPE_SAVE)
+        {
+            if (This->current_filter)
+                newext = get_first_ext_from_spec(extbuf, This->current_filter);
+            if (!newext && This->default_ext)
+            {
+                lstrcpyW(extbuf, L".");
+                lstrcatW(extbuf, This->default_ext);
+                newext = extbuf;
+            }
+            if (newext && lstrcmpiW(PathFindExtensionW(filename), newext) &&
+                lstrlenW(filename) + lstrlenW(newext) < MAX_PATH)
+            {
+                lstrcatW(filename, newext);
+                if (!i) appended = TRUE;
+            }
+        }
+
+        if (!(pidla[i] = SHSimpleIDListFromPath(filename))) continue;
+        if (!i) set_file_name(This, PathFindFileNameW(filename));
+        i++;
+    }
+    count = i;
+
+    hr = count ? SHGetDesktopFolder(&psf_desktop) : E_FAIL;
+    if (SUCCEEDED(hr))
+    {
+        if (This->psia_results)
+        {
+            IShellItemArray_Release(This->psia_results);
+            This->psia_results = NULL;
+        }
+        hr = SHCreateShellItemArray(NULL, psf_desktop, count, (PCUITEMID_CHILD_ARRAY)pidla, &This->psia_results);
+        IShellFolder_Release(psf_desktop);
+    }
+
+    for (i = 0; i < count; i++) ILFree(pidla[i]);
+    free(pidla);
+    if (FAILED(hr)) return hr;
+
+    if (SUCCEEDED(IShellItemArray_GetItemAt(This->psia_results, 0, &item)))
+    {
+        IShellItem *parent;
+        if (SUCCEEDED(IShellItem_GetParent(item, &parent)))
+        {
+            if (This->psi_folder) IShellItem_Release(This->psi_folder);
+            This->psi_folder = parent;
+        }
+        IShellItem_Release(item);
+    }
+
+    if ((This->options & FOS_OVERWRITEPROMPT) && This->dlg_type == ITEMDLG_TYPE_SAVE)
+    {
+        IShellItem *shellitem;
+        if (SUCCEEDED(IShellItemArray_GetItemAt(This->psia_results, 0, &shellitem)))
+        {
+            /* The Mac panel has already asked about replacing the name it returned, but not about an extension added here */
+            if (shell_item_exists(shellitem)) hr = events_OnOverwrite(This, shellitem, appended);
+            IShellItem_Release(shellitem);
+            if (FAILED(hr)) return S_FALSE;
+        }
+    }
+
+    return events_OnFileOk(This) == S_OK ? S_OK : S_FALSE;
+}
+
+/* Shows the native macOS panel in place of the Wine dialog; returns E_NOTIMPL when the Wine dialog should be used instead */
+static HRESULT show_mac_dialog(FileDialogImpl *This, HWND owner)
+{
+    struct mac_file_dialog_funcs funcs;
+    HWND root = owner ? GetAncestor(owner, GA_ROOT) : NULL;
+    BOOL owner_enabled = FALSE, first = TRUE;
+    char *unix_dir, *paths;
+    WCHAR *filters;
+    UINT flags = 0, status, needed, filter_index;
+    UINT64 handle;
+    HRESULT hr;
+    MSG msg;
+
+    if (!get_mac_file_dialog_funcs(This, &funcs)) return E_NOTIMPL;
+
+    if (This->dlg_type == ITEMDLG_TYPE_SAVE) flags |= MAC_FILE_DIALOG_SAVE;
+    if (This->options & FOS_ALLOWMULTISELECT) flags |= MAC_FILE_DIALOG_MULTISELECT;
+    if (This->options & FOS_PICKFOLDERS) flags |= MAC_FILE_DIALOG_FOLDERS;
+    if (This->options & FOS_FORCESHOWHIDDEN) flags |= MAC_FILE_DIALOG_HIDDEN;
+
+    unix_dir = get_mac_start_dir(This);
+    filters = get_mac_filters(This);
+
+    if (!GetCurrentActCtx(&This->user_actctx))
+        This->user_actctx = INVALID_HANDLE_VALUE;
+
+    for (;;)
+    {
+        handle = funcs.show(flags, This->custom_title, This->custom_okbutton, unix_dir, This->set_filename, filters,
+                            This->filterspec_count, This->filetypeindex);
+        if (!handle)
+        {
+            hr = first ? E_NOTIMPL : E_FAIL;
+            break;
+        }
+        if (first && root) owner_enabled = !EnableWindow(root, FALSE);
+        first = FALSE;
+
+        while ((status = funcs.result(handle, NULL, 0, &needed, &filter_index)) == MAC_FILE_DIALOG_PENDING)
+        {
+            MsgWaitForMultipleObjectsEx(0, NULL, 50, QS_ALLINPUT, MWMO_INPUTAVAILABLE);
+            while (PeekMessageW(&msg, 0, 0, 0, PM_REMOVE))
+            {
+                if (msg.message == WM_QUIT)
+                {
+                    PostQuitMessage(msg.wParam);
+                    break;
+                }
+                TranslateMessage(&msg);
+                DispatchMessageW(&msg);
+            }
+            if (msg.message == WM_QUIT) break;
+        }
+
+        paths = NULL;
+        if (status == MAC_FILE_DIALOG_OK && (paths = malloc(needed)))
+            funcs.result(handle, paths, needed, &needed, &filter_index);
+        funcs.close(handle);
+
+        if (!paths)
+        {
+            hr = HRESULT_FROM_WIN32(ERROR_CANCELLED);
+            break;
+        }
+
+        hr = set_mac_results(This, paths, filter_index);
+        free(paths);
+        if (hr != S_FALSE) break;
+    }
+
+    if (This->user_actctx != INVALID_HANDLE_VALUE)
+    {
+        ReleaseActCtx(This->user_actctx);
+        This->user_actctx = INVALID_HANDLE_VALUE;
+    }
+    if (owner_enabled) EnableWindow(root, TRUE);
+    if (root && hr != E_NOTIMPL) SetForegroundWindow(root);
+
+    HeapFree(GetProcessHeap(), 0, unix_dir);
+    free(filters);
+    return hr;
+}
+
 static HRESULT WINAPI IFileDialog2_fnShow(IFileDialog2 *iface, HWND hwndOwner)
 {
     FileDialogImpl *This = impl_from_IFileDialog2(iface);
+    HRESULT hr;
     TRACE("%p (%p)\n", iface, hwndOwner);
 
     This->opendropdown_has_selection = FALSE;
 
+    if ((hr = show_mac_dialog(This, hwndOwner)) != E_NOTIMPL)
+        return hr;
+
     return create_dialog(This, hwndOwner);
 }
 

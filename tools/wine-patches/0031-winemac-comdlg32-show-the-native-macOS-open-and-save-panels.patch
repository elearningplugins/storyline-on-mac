diff --git a/dlls/winemac.drv/cocoa_filedialog.m b/dlls/winemac.drv/cocoa_filedialog.m
new file mode 100644
--- /dev/null
+++ b/dlls/winemac.drv/cocoa_filedialog.m
@@ -0,0 +1,265 @@
+/* MACDRV Cocoa open and save panels; LGPL 2.1 or later, like the rest of Wine */
+
+#import <AppKit/AppKit.h>
+#include <fnmatch.h>
+#include "macdrv_cocoa.h"
+#import "cocoa_app.h"
+
+
+@interface WineFileDialog : NSObject <NSOpenSavePanelDelegate>
+{
+@public
+    unsigned int flags;
+    NSString* title;
+    NSString* prompt;
+    NSString* directory;
+    NSString* name;
+    NSArray* filterNames;
+    NSArray* filterPatterns;
+    NSInteger filterIndex;
+    NSSavePanel* panel;
+    NSPopUpButton* popup;
+    NSArray* paths;
+    int status;
+}
+@end
+
+
+@implementation WineFileDialog
+
+    - (void) dealloc
+    {
+        [title release];
+        [prompt release];
+        [directory release];
+        [name release];
+        [filterNames release];
+        [filterPatterns release];
+        [panel release];
+        [popup release];
+        [paths release];
+        [super dealloc];
+    }
+
+    static BOOL pattern_matches_all(NSString* pattern)
+    {
+        return [pattern isEqualToString:@"*"] || [pattern isEqualToString:@"*.*"];
+    }
+
+    /* Only plain "*.ext" patterns can become allowed file types; anything else leaves the save panel unrestricted */
+    static NSArray* extensions_for_patterns(NSArray* patterns)
+    {
+        NSCharacterSet* wildcards = [NSCharacterSet characterSetWithCharactersInString:@"*?["];
+        NSMutableArray* extensions = [NSMutableArray array];
+
+        for (NSString* pattern in patterns)
+        {
+            NSString* extension;
+
+            if (![pattern hasPrefix:@"*."] || pattern.length <= 2) return nil;
+            extension = [pattern substringFromIndex:2];
+            if ([extension rangeOfCharacterFromSet:wildcards].location != NSNotFound) return nil;
+            [extensions addObject:extension];
+        }
+
+        return extensions.count ? extensions : nil;
+    }
+
+    - (NSArray*) currentPatterns
+    {
+        if (filterIndex < 0 || filterIndex >= (NSInteger)filterPatterns.count) return nil;
+        return filterPatterns[filterIndex];
+    }
+
+    - (void) applyFilter
+    {
+        if (flags & MACDRV_FILE_DIALOG_SAVE)
+        {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+            panel.allowedFileTypes = extensions_for_patterns([self currentPatterns]);
+#pragma clang diagnostic pop
+        }
+        else
+            [(NSOpenPanel*)panel validateVisibleColumns];
+    }
+
+    - (void) filterChanged:(id)sender
+    {
+        filterIndex = [popup indexOfSelectedItem];
+        [self applyFilter];
+    }
+
+    - (BOOL) panel:(id)sender shouldEnableURL:(NSURL*)url
+    {
+        NSArray* patterns = [self currentPatterns];
+        NSNumber* isDirectory;
+        const char* filename;
+
+        if (!patterns.count || (flags & MACDRV_FILE_DIALOG_FOLDERS)) return YES;
+        if ([url getResourceValue:&isDirectory forKey:NSURLIsDirectoryKey error:NULL] && isDirectory.boolValue)
+            return YES;
+
+        filename = url.lastPathComponent.fileSystemRepresentation;
+        for (NSString* pattern in patterns)
+        {
+            if (pattern_matches_all(pattern) || !fnmatch(pattern.fileSystemRepresentation, filename, FNM_CASEFOLD))
+                return YES;
+        }
+        return NO;
+    }
+
+    - (NSView*) filterAccessoryView
+    {
+        NSTextField* label = [NSTextField labelWithString:@"File type:"];
+        NSStackView* stack;
+
+        popup = [[NSPopUpButton alloc] initWithFrame:NSZeroRect pullsDown:NO];
+        for (NSString* filterName in filterNames)
+            [popup.menu addItemWithTitle:filterName action:NULL keyEquivalent:@""];
+        [popup selectItemAtIndex:filterIndex];
+        popup.target = self;
+        popup.action = @selector(filterChanged:);
+
+        stack = [NSStackView stackViewWithViews:@[label, popup]];
+        stack.edgeInsets = NSEdgeInsetsMake(8, 20, 8, 20);
+        [stack setFrameSize:stack.fittingSize];
+        return stack;
+    }
+
+    - (void) show
+    {
+        if (flags & MACDRV_FILE_DIALOG_SAVE)
+            panel = [[NSSavePanel savePanel] retain];
+        else
+        {
+            NSOpenPanel* openPanel = [NSOpenPanel openPanel];
+            openPanel.canChooseFiles = !(flags & MACDRV_FILE_DIALOG_FOLDERS);
+            openPanel.canChooseDirectories = (flags & MACDRV_FILE_DIALOG_FOLDERS) != 0;
+            openPanel.allowsMultipleSelection = (flags & MACDRV_FILE_DIALOG_MULTISELECT) != 0;
+            panel = [openPanel retain];
+        }
+
+        panel.delegate = self;
+        panel.canCreateDirectories = YES;
+        panel.showsHiddenFiles = (flags & MACDRV_FILE_DIALOG_HIDDEN) != 0;
+        /* Save panels show a title bar and open panels do not, so the title goes to one place or the other */
+        if (title.length && (flags & MACDRV_FILE_DIALOG_SAVE))
+            panel.title = title;
+        else if (title.length)
+            panel.message = title;
+        if (prompt.length) panel.prompt = prompt;
+        if (directory.length)
+            panel.directoryURL = [NSURL fileURLWithPath:directory.stringByResolvingSymlinksInPath isDirectory:YES];
+        if ((flags & MACDRV_FILE_DIALOG_SAVE) && name.length) panel.nameFieldStringValue = name;
+        if (filterNames.count > 1 && !(flags & MACDRV_FILE_DIALOG_FOLDERS))
+        {
+            panel.accessoryView = [self filterAccessoryView];
+            if (!(flags & MACDRV_FILE_DIALOG_SAVE))
+                ((NSOpenPanel*)panel).accessoryViewDisclosed = YES;
+        }
+        [self applyFilter];
+
+        [NSApp activateIgnoringOtherApps:YES];
+        [self retain];
+        [panel beginWithCompletionHandler:^(NSModalResponse response){
+            if (response == NSModalResponseOK)
+            {
+                if (flags & MACDRV_FILE_DIALOG_SAVE)
+                    paths = [@[panel.URL.path] retain];
+                else
+                    paths = [[((NSOpenPanel*)panel).URLs valueForKey:@"path"] retain];
+            }
+            __atomic_store_n(&status, response == NSModalResponseOK ? MACDRV_FILE_DIALOG_OK : MACDRV_FILE_DIALOG_CANCEL,
+                             __ATOMIC_RELEASE);
+            [self release];
+        }];
+    }
+
+@end
+
+
+/* Shows a native open or save panel without waiting for it; poll it with macdrv_file_dialog_status */
+macdrv_file_dialog macdrv_file_dialog_start(unsigned int flags, CFStringRef title, CFStringRef prompt,
+                                            CFStringRef directory, CFStringRef name, CFArrayRef filter_names,
+                                            CFArrayRef filter_specs, unsigned int filter_index)
+{
+@autoreleasepool
+{
+    WineFileDialog* dialog = [[WineFileDialog alloc] init];
+    NSMutableArray* patterns = [NSMutableArray array];
+
+    for (NSString* spec in (NSArray*)filter_specs)
+    {
+        NSMutableArray* specPatterns = [NSMutableArray array];
+        for (NSString* pattern in [spec componentsSeparatedByString:@";"])
+        {
+            pattern = [pattern stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+            if (pattern.length) [specPatterns addObject:pattern];
+        }
+        [patterns addObject:specPatterns];
+    }
+
+    dialog->flags = flags;
+    dialog->title = [(NSString*)title copy];
+    dialog->prompt = [(NSString*)prompt copy];
+    dialog->directory = [(NSString*)directory copy];
+    dialog->name = [(NSString*)name copy];
+    dialog->filterNames = [(NSArray*)filter_names copy];
+    dialog->filterPatterns = [patterns copy];
+    dialog->filterIndex = filter_index;
+
+    [dialog retain];
+    OnMainThreadAsync(^{
+        [dialog show];
+        [dialog release];
+    });
+
+    return (macdrv_file_dialog)dialog;
+}
+}
+
+int macdrv_file_dialog_status(macdrv_file_dialog d)
+{
+    WineFileDialog* dialog = (WineFileDialog*)d;
+    return __atomic_load_n(&dialog->status, __ATOMIC_ACQUIRE);
+}
+
+/* Copies the chosen paths as consecutive nul-terminated UTF-8 strings followed by an empty one, and returns the size that needs */
+unsigned int macdrv_file_dialog_result(macdrv_file_dialog d, char* buffer, unsigned int size,
+                                       unsigned int* filter_index)
+{
+@autoreleasepool
+{
+    WineFileDialog* dialog = (WineFileDialog*)d;
+    unsigned int needed = 1, pos = 0;
+
+    if (macdrv_file_dialog_status(d) != MACDRV_FILE_DIALOG_OK) return 0;
+
+    *filter_index = dialog->filterIndex;
+    for (NSString* path in dialog->paths)
+        needed += strlen(path.fileSystemRepresentation) + 1;
+    if (!buffer || size < needed) return needed;
+
+    for (NSString* path in dialog->paths)
+    {
+        const char* utf8 = path.fileSystemRepresentation;
+        strcpy(buffer + pos, utf8);
+        pos += strlen(utf8) + 1;
+    }
+    buffer[pos] = 0;
+    return needed;
+}
+}
+
+/* Cancels the panel if it is still open and releases it */
+void macdrv_file_dialog_close(macdrv_file_dialog d)
+{
+    WineFileDialog* dialog = (WineFileDialog*)d;
+
+    OnMainThreadAsync(^{
+        if (!macdrv_file_dialog_status(d) && dialog->panel)
+            [dialog->panel cancel:nil];
+        [dialog release];
+    });
+}

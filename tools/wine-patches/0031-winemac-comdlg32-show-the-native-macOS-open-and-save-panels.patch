+/* comdlg32 shows the native open and save panels through these three exports; the handle is 0 on failure */
+UINT64 CDECL wine_file_dialog_show(UINT flags, const WCHAR *title, const WCHAR *prompt, const char *unix_dir,
+                                   const WCHAR *name, const WCHAR *filters, UINT filter_count, UINT filter_index)
+{
+    struct file_dialog_start_params params =
+    {
+        .flags = flags, .filter_count = filter_count, .filter_index = filter_index,
+        .title = (UINT_PTR)title, .prompt = (UINT_PTR)prompt, .unix_dir = (UINT_PTR)unix_dir,
+        .name = (UINT_PTR)name, .filters = (UINT_PTR)filters,
+    };
+
+    if (MACDRV_CALL(file_dialog_start, &params)) return 0;
+    return params.handle;
+}
+
+UINT CDECL wine_file_dialog_result(UINT64 handle, char *buffer, UINT size, UINT *needed, UINT *filter_index)
+{
+    struct file_dialog_result_params params = { .handle = handle, .buffer = (UINT_PTR)buffer, .size = size };
+
+    MACDRV_CALL(file_dialog_result, &params);
+    *needed = params.needed;
+    *filter_index = params.filter_index;
+    return params.status;
+}
+
+void CDECL wine_file_dialog_close(UINT64 handle)
+{
+    struct file_dialog_close_params params = { .handle = handle };
+    MACDRV_CALL(file_dialog_close, &params);
+}
+
+

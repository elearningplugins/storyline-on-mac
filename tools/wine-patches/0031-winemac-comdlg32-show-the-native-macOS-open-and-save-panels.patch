 {
     struct init_params params;
diff --git a/dlls/winemac.drv/macdrv_cocoa.h b/dlls/winemac.drv/macdrv_cocoa.h
--- a/dlls/winemac.drv/macdrv_cocoa.h
+++ b/dlls/winemac.drv/macdrv_cocoa.h
@@ -210,6 +210,31 @@ extern void macdrv_set_mouse_capture_window(macdrv_window window);
 extern void macdrv_set_cocoa_retina_mode(bool new_mode);
 
 
+/* file dialog */
+typedef struct opaque_macdrv_file_dialog* macdrv_file_dialog;
+
+enum {
+    MACDRV_FILE_DIALOG_SAVE         = 0x1,
+    MACDRV_FILE_DIALOG_MULTISELECT  = 0x2,
+    MACDRV_FILE_DIALOG_FOLDERS      = 0x4,
+    MACDRV_FILE_DIALOG_HIDDEN       = 0x8,
+};
+
+enum {

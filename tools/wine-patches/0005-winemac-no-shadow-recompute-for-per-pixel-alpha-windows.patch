+
+
+/***********************************************************************
+ *              macdrv_get_display_colorspace
+ *
+ * Colour space of the main display, so surface images flush without a
+ * per-frame colour conversion. Cached; the caller must not release it.
+ */
+CGColorSpaceRef macdrv_get_display_colorspace(void)
+{
+    static CGColorSpaceRef colorspace;
+    if (!colorspace)
+    {
+        CGColorSpaceRef cs = NULL;
+        @autoreleasepool
+        {
+            NSScreen *screen = [NSScreen mainScreen];
+            if (screen) cs = CGColorSpaceRetain([[screen colorSpace] CGColorSpace]);
+        }
+        if (!cs) cs = CGColorSpaceCreateDeviceRGB();
+        colorspace = cs;
+    }
+    return colorspace;
 }

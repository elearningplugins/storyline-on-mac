+/* per-category component CLSIDs, re-read only after the category's Instance key reports a change */
+struct category_cache {
+    HKEY key;
+    HANDLE changed;
+    CLSID *clsids;
+    UINT count;
+};
+
+static struct category_cache category_caches[ARRAY_SIZE(categories) - 1];
+
+static CRITICAL_SECTION category_cache_cs;
+static CRITICAL_SECTION_DEBUG category_cache_cs_dbg =
+{
+    0, 0, &category_cache_cs,
+    { &category_cache_cs_dbg.ProcessLocksList, &category_cache_cs_dbg.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": category_cache") }
+};
+static CRITICAL_SECTION category_cache_cs = { &category_cache_cs_dbg, -1, 0, 0, 0, 0 };
+
+static LONG read_category_clsids(struct category_cache *cache)
+{
+    WCHAR guidstring[39];
+    CLSID *clsids = NULL, *grown, clsid;
+    UINT count = 0, capacity = 0;
+    DWORD i, size;
+    LONG res;
 
+    for (i = 0;; i++)
+    {
+        size = ARRAY_SIZE(guidstring);
+        res = RegEnumKeyExW(cache->key, i, guidstring, &size, NULL, NULL, NULL, NULL);
+        if (res == ERROR_NO_MORE_ITEMS) break;
+        if (res != ERROR_SUCCESS) { free(clsids); return res; }
+        if (FAILED(CLSIDFromString(guidstring, &clsid))) continue;
+        if (count == capacity)
+        {
+            capacity = capacity ? capacity * 2 : 16;
+            if (!(grown = realloc(clsids, capacity * sizeof(*clsids)))) { free(clsids); return ERROR_OUTOFMEMORY; }
+            clsids = grown;
+        }
+        clsids[count++] = clsid;
+    }
+
+    free(cache->clsids);
+    cache->clsids = clsids;
+    cache->count = count;
+    return ERROR_SUCCESS;
+}
+
+static HRESULT get_category_clsids(const struct category *category, CLSID **clsids, UINT *count)
+{
+    struct category_cache *cache = &category_caches[category - categories];
+    WCHAR guidstring[39], path[64];
+    BOOL cached;
+    LONG res = ERROR_SUCCESS;
+
+    EnterCriticalSection(&category_cache_cs);
+
+    cached = cache->changed && WaitForSingleObject(cache->changed, 0) == WAIT_TIMEOUT;
+    if (!cached)
+    {
+        if (!cache->key)
+        {
+            StringFromGUID2(category->catid, guidstring, ARRAY_SIZE(guidstring));
+            swprintf(path, ARRAY_SIZE(path), L"CLSID\\%s\\Instance", guidstring);
+            res = RegOpenKeyExW(HKEY_CLASSES_ROOT, path, 0, KEY_READ | KEY_NOTIFY, &cache->key);
+            if (res != ERROR_SUCCESS) cache->key = NULL;
+        }
+        if (cache->key)
+        {
+            if (!cache->changed) cache->changed = CreateEventW(NULL, TRUE, FALSE, NULL);
+            else ResetEvent(cache->changed);
+            /* register before reading so a change made while reading still invalidates the list */
+            if (cache->changed && RegNotifyChangeKeyValue(cache->key, FALSE, REG_NOTIFY_CHANGE_NAME,
+                    cache->changed, TRUE) != ERROR_SUCCESS)
+            {
+                CloseHandle(cache->changed);
+                cache->changed = NULL;
+            }
+            res = read_category_clsids(cache);
+            if (res != ERROR_SUCCESS && cache->changed)
+            {
+                CloseHandle(cache->changed);
+                cache->changed = NULL;
+            }
+        }
+    }
+
+    *clsids = NULL;
+    *count = 0;
+    if (res == ERROR_SUCCESS && cache->count)
+    {
+        if ((*clsids = malloc(cache->count * sizeof(**clsids))))
+        {
+            memcpy(*clsids, cache->clsids, cache->count * sizeof(**clsids));
+            *count = cache->count;
+        }
+        else res = ERROR_OUTOFMEMORY;
+    }
+
+    LeaveCriticalSection(&category_cache_cs);
+    return HRESULT_FROM_WIN32(res);
+}

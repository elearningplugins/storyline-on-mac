 static HRESULT WINAPI dwritetextanalyzer1_JustifyGlyphAdvances(IDWriteTextAnalyzer2 *iface,
     FLOAT width, UINT32 glyph_count, const DWRITE_JUSTIFICATION_OPPORTUNITY *jo, const FLOAT *advances,
     const DWRITE_GLYPH_OFFSET *offsets, FLOAT *justifiedadvances, DWRITE_GLYPH_OFFSET *justifiedoffsets)
 {
-    FIXME("(%.2f %u %p %p %p %p %p): stub\n", width, glyph_count, jo, advances, offsets, justifiedadvances,
+    FLOAT total = 0.0f, delta, capacity, applied;
+    UINT32 i, priority;
+    BOOL expand;
+
+    TRACE("(%.2f %u %p %p %p %p %p)\n", width, glyph_count, jo, advances, offsets, justifiedadvances,
         justifiedoffsets);
-    return E_NOTIMPL;
+
+    if (!glyph_count) return S_OK;
+    if (!jo || !advances || !justifiedadvances) return E_INVALIDARG;
+
+    memcpy(justifiedadvances, advances, glyph_count * sizeof(*advances));
+    if (justifiedoffsets)
+    {
+        if (offsets) memcpy(justifiedoffsets, offsets, glyph_count * sizeof(*offsets));
+        else memset(justifiedoffsets, 0, glyph_count * sizeof(*offsets));
+    }
+
+    for (i = 0; i < glyph_count; ++i) total += advances[i];
+    delta = width - total;
+    if (delta == 0.0f) return S_OK;
+    expand = delta > 0.0f;
+    if (!expand) delta = -delta;
+
+    /* Distribute the difference by priority (lower values first), proportionally to each
+       opportunity's capacity, then hand any residual to the opportunities that allow it. */
+    for (priority = 1; priority < 256 && delta > 0.0f; ++priority)
+    {
+        capacity = 0.0f;
+        for (i = 0; i < glyph_count; ++i)
+        {
+            if (expand && jo[i].expansionPriority == priority) capacity += jo[i].expansionMaximum;
+            if (!expand && jo[i].compressionPriority == priority) capacity += jo[i].compressionMaximum;
+        }
+        if (capacity <= 0.0f) continue;
+        applied = min(delta, capacity);
+        for (i = 0; i < glyph_count; ++i)
+        {
+            FLOAT max = expand ? jo[i].expansionMaximum : jo[i].compressionMaximum;
+            FLOAT amount;
+            if ((expand ? jo[i].expansionPriority : jo[i].compressionPriority) != priority || max <= 0.0f) continue;
+            amount = applied * (max / capacity);
+            if (!expand) amount = -amount;
+            justifiedadvances[i] += amount;
+            if (jo[i].applyToLeadingEdge && justifiedoffsets) justifiedoffsets[i].advanceOffset += amount;
+        }
+        delta -= applied;
+    }
+
+    if (delta > 0.0f)
+    {
+        UINT32 residual = 0;
+        for (i = 0; i < glyph_count; ++i)
+            if (expand ? jo[i].allowResidualExpansion : jo[i].allowResidualCompression) residual++;
+        if (residual)
+        {
+            FLOAT amount = delta / residual;
+            if (!expand) amount = -amount;
+            for (i = 0; i < glyph_count; ++i)
+                if (expand ? jo[i].allowResidualExpansion : jo[i].allowResidualCompression)
+                    justifiedadvances[i] += amount;
+        }
+    }
+
+    return S_OK;
 }
 

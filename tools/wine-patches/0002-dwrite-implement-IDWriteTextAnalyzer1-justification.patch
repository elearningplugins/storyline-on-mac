+            jo[i].expansionMaximum = font_em_size / 4.0f;
+            jo[i].compressionMaximum = font_em_size / 16.0f;
+            jo[i].expansionPriority = 2;
+            jo[i].compressionPriority = 2;
+            jo[i].allowResidualExpansion = 1;
+            jo[i].applyToTrailingEdge = 1;

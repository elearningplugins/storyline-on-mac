+            jo[g].compressionMaximum = font_em_size / 8.0f;
+            jo[g].expansionPriority = 1;
+            jo[g].compressionPriority = 1;
+            jo[g].allowResidualExpansion = 1;
+            jo[g].allowResidualCompression = 1;
+            jo[g].applyToTrailingEdge = 1;
+        }
+    }
+
+    for (i = 0; i < glyph_count; ++i)
+    {
+        if (jo[i].expansionPriority) continue;
+        switch (prop[i].justification)
+        {
+        case SCRIPT_JUSTIFY_BLANK:
+        case SCRIPT_JUSTIFY_ARABIC_BLANK:
+            jo[i].expansionMaximum = font_em_size * 1.5f;
+            jo[i].compressionMaximum = font_em_size / 8.0f;
+            jo[i].expansionPriority = 1;
+            jo[i].compressionPriority = 1;
+            jo[i].allowResidualExpansion = 1;
+            jo[i].allowResidualCompression = 1;
+            jo[i].applyToTrailingEdge = 1;
+            break;

+/* WINE_PERF_LOG=1: one "perf <seconds> <pid> <tid> win32u ..." line per event on stderr, for the timing research in runs/. */
+static inline BOOL perf_log_enabled(void)
+{
+    static int enabled = -1;
+    const char *value;
+
+    if (enabled < 0 && (enabled = (value = getenv( "WINE_PERF_LOG" )) && *value && *value != '0'))
+    {
+        LARGE_INTEGER counter, freq;
+        struct timeval tv;
+
+        gettimeofday( &tv, NULL );
+        NtQueryPerformanceCounter( &counter, &freq );
+        fprintf( stderr, "perf %u.%06u %04x %04x win32u sync epoch_us=%llu\n",
+                 (unsigned int)(counter.QuadPart / freq.QuadPart), (unsigned int)(counter.QuadPart % freq.QuadPart / (freq.QuadPart / 1000000)),
+                 (unsigned int)GetCurrentProcessId(), (unsigned int)GetCurrentThreadId(),
+                 (unsigned long long)tv.tv_sec * 1000000 + tv.tv_usec );
+    }
+    return enabled;
+}
+/* WINE_ULW_NOCOPY=1 turns off patch 0006's copy fast path so its effect can be measured A/B. */
+static inline BOOL perf_ulw_nocopy(void)
+{
+    static int disabled = -1;
+    const char *value;
+
+    if (disabled < 0) disabled = (value = getenv( "WINE_ULW_NOCOPY" )) && *value && *value != '0';
+    return disabled;
+}
+static inline ULONGLONG perf_now_us(void)
+{
+    LARGE_INTEGER counter, freq;
+
+    NtQueryPerformanceCounter( &counter, &freq );
+    return counter.QuadPart / (freq.QuadPart / 1000000);
+}
+#define PERF_LOG(t, fmt, ...) fprintf( stderr, "perf %u.%06u %04x %04x win32u " fmt "\n", (unsigned int)((t) / 1000000), \
+        (unsigned int)((t) % 1000000), (unsigned int)GetCurrentProcessId(), (unsigned int)GetCurrentThreadId(), __VA_ARGS__ )
+static inline const char *perf_class_name( HWND hwnd )
+{
+    static __thread char name[64];
+    WCHAR buffer[64];
+    UNICODE_STRING str = { 0, sizeof(buffer), buffer };
+    int i, len = NtUserGetClassName( hwnd, FALSE, &str );
+
+    for (i = 0; i < len && i < (int)sizeof(name) - 1; i++) name[i] = buffer[i] < 0x80 && buffer[i] > ' ' ? buffer[i] : '_';
+    name[i] = 0;
+    return name;
 }
 

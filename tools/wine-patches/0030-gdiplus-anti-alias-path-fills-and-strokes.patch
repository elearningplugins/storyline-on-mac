+static void add_span_coverage(BYTE *row, INT left, INT right)
+{
+    INT first = left / 4, last = (right - 1) / 4, x;
+
+    if (first == last)
+    {
+        row[first] += right - left;
+        return;
+    }
+
+    row[first] += 4 * (first + 1) - left;
+    for (x = first + 1; x < last; x++)
+        row[x] += 4;
+    row[last] += right - 4 * last;
 }

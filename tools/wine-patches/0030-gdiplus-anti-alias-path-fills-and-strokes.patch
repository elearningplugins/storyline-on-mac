+static GpStatus AA_GdipFillPath(GpGraphics *graphics, GpBrush *brush, GpPath *path)
+{
+    GpStatus stat;
+    GpPath *sample_path = NULL;
+    GpRegion *region = NULL;
+    GpMatrix transform;
+    GpRectF bounds;
+    GpRect rect;
+    RECT sample_bounds, clip_box;
+    HRGN hrgn = NULL, clip = NULL;
+    RGNDATA *rgndata = NULL;
+    RECT *rects;
+    BYTE *coverage = NULL;
+    DWORD *pixels = NULL;
+    DWORD size, i;
+    INT y, left, top, right, bottom;
 
+    if (!brush_can_fill_pixels(brush))
+        return NotImplemented;
+
+    stat = gdi_transform_acquire(graphics);
+    if (stat != Ok)
+        return stat;
+
+    stat = GdipClonePath(path, &sample_path);
+    if (stat == Ok)
+        stat = get_graphics_transform(graphics, WineCoordinateSpaceGdiDevice, CoordinateSpaceWorld, &transform);
+    if (stat == Ok)
+        stat = GdipTransformPath(sample_path, &transform);
+    if (stat == Ok)
+        stat = GdipGetPathWorldBounds(sample_path, &bounds, NULL, NULL);
+    if (stat == Ok)
+        stat = get_clip_hrgn(graphics, &clip);
+    if (stat != Ok)
+        goto done;
+
+    left = floorf(bounds.X) - 1;
+    top = floorf(bounds.Y) - 1;
+    right = ceilf(bounds.X + bounds.Width) + 2;
+    bottom = ceilf(bounds.Y + bounds.Height) + 2;
+    if (clip)
+    {
+        if (GetRgnBox(clip, &clip_box) == NULLREGION)
+            goto done;
+        left = max(left, clip_box.left);
+        top = max(top, clip_box.top);
+        right = min(right, clip_box.right);
+        bottom = min(bottom, clip_box.bottom);
+    }
+    if (right <= left || bottom <= top)
+        goto done;
+
+    /* Beyond this the 4x4 sample grid is too costly; the aliased path still draws the shape */
+    if ((LONGLONG)(right - left) * (bottom - top) > 4096 * 4096)
+    {
+        stat = NotImplemented;
+        goto done;
+    }
+
+    rect.X = left;
+    rect.Y = top;
+    rect.Width = right - left;
+    rect.Height = bottom - top;
+
+    /* The region scanner samples at integer points, so this places each pixel's 16 samples at +/-0.125 and +/-0.375 around its center */
+    GdipSetMatrixElements(&transform, 4.0, 0.0, 0.0, 4.0, 1.5 - 4.0 * left, 1.5 - 4.0 * top);
+    stat = GdipTransformPath(sample_path, &transform);
+    if (stat == Ok)
+        stat = GdipCreateRegionPath(sample_path, &region);
+    if (stat == Ok)
+    {
+        SetRect(&sample_bounds, 0, 0, 4 * rect.Width, 4 * rect.Height);
+        stat = get_region_hrgn(&region->node, &sample_bounds, &hrgn);
+    }
+    if (stat != Ok || !hrgn)
+        goto done;
+
+    size = GetRegionData(hrgn, 0, NULL);
+    rgndata = malloc(size);
+    coverage = calloc(rect.Width * rect.Height, sizeof(*coverage));
+    pixels = calloc(rect.Width * rect.Height, sizeof(*pixels));
+    if (!rgndata || !coverage || !pixels)
+    {
+        stat = OutOfMemory;
+        goto done;
+    }
+    GetRegionData(hrgn, size, rgndata);
+
+    rects = (RECT *)rgndata->Buffer;
+    for (i = 0; i < rgndata->rdh.nCount; i++)
+    {
+        INT span_left = max(rects[i].left, 0), span_right = min(rects[i].right, 4 * rect.Width);
+
+        if (span_left >= span_right)
+            continue;
+        for (y = max(rects[i].top, 0); y < min(rects[i].bottom, 4 * rect.Height); y++)
+            add_span_coverage(coverage + (y / 4) * rect.Width, span_left, span_right);
+    }
+
+    stat = brush_fill_pixels(graphics, brush, pixels, &rect, rect.Width);
+    if (stat != Ok)
+        goto done;
+
+    for (i = 0; i < rect.Width * rect.Height; i++)
+    {
+        if (!coverage[i])
+            pixels[i] = 0;
+        else if (coverage[i] < 16)
+            pixels[i] = (pixels[i] & 0xffffff) | (((pixels[i] >> 24) * coverage[i] / 16) << 24);
+    }
+
+    stat = alpha_blend_pixels(graphics, rect.X, rect.Y, (BYTE *)pixels, rect.Width, rect.Height,
+        rect.Width * 4, PixelFormat32bppARGB);
+
+done:
+    free(pixels);
+    free(coverage);
+    free(rgndata);
+    if (hrgn)
+        DeleteObject(hrgn);
+    if (clip)
+        DeleteObject(clip);
+    GdipDeleteRegion(region);
+    GdipDeletePath(sample_path);
+    gdi_transform_release(graphics);
+
+    return stat;
+}

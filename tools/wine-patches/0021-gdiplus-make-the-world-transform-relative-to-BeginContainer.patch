+
+/* Inside a BeginContainer block the world transform is relative to the transform in effect when the block began, as on Windows. */
+static BOOL get_container_base(GpGraphics *graphics, GpMatrix *base)
+{
+    GraphicsContainerItem *container;
+
+    LIST_FOR_EACH_ENTRY(container, &graphics->containers, GraphicsContainerItem, entry)
+    {
+        if (container->type != BEGIN_CONTAINER) continue;
+        *base = container->base;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void get_local_worldtrans(GpGraphics *graphics, GpMatrix *local)
+{
+    GpMatrix base;
+    BOOL invertible;
+
+    *local = graphics->worldtrans;
+    if (!get_container_base(graphics, &base)) return;
+    if (GdipIsMatrixInvertible(&base, &invertible) != Ok || !invertible) return;
+    GdipInvertMatrix(&base);
+    GdipMultiplyMatrix(local, &base, MatrixOrderAppend);
 }
 
+static void set_local_worldtrans(GpGraphics *graphics, const GpMatrix *local)
+{
+    GpMatrix base;
+
+    graphics->worldtrans = *local;
+    if (get_container_base(graphics, &base))
+        GdipMultiplyMatrix(&graphics->worldtrans, &base, MatrixOrderAppend);
+}
+

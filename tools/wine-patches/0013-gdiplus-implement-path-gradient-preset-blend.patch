+/* position 0 is the path boundary and 1 the center point, as for GdipSetPathGradientPresetBlend */
+static ARGB blend_path_gradient_preset(const GpPathGradient *brush, REAL position)
+{
+    int i = 1;
+    REAL range;
+
+    if (position <= brush->pblendpos[0]) return brush->pblendcolor[0];
+    if (position >= brush->pblendpos[brush->pblendcount-1]) return brush->pblendcolor[brush->pblendcount-1];
+
+    while (i < brush->pblendcount - 1 && position > brush->pblendpos[i])
+        i++;
+
+    range = brush->pblendpos[i] - brush->pblendpos[i-1];
+    if (range <= 0.0f) return brush->pblendcolor[i];
+    return blend_colors(brush->pblendcolor[i-1], brush->pblendcolor[i], (position - brush->pblendpos[i-1]) / range);
+}

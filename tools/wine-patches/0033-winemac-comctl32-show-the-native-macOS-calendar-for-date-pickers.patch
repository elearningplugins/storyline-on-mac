+/* comctl32 shows the native calendar popover below the date picker hwnd through these three exports; dates are yyyymmdd */
+UINT64 CDECL wine_date_picker_show(HWND hwnd, UINT date, UINT min_date, UINT max_date)
+{
+    struct date_picker_start_params params =
+    {
+        .hwnd = HandleToUlong(hwnd), .date = date, .min_date = min_date, .max_date = max_date,
+    };
+
+    if (MACDRV_CALL(date_picker_start, &params)) return 0;
+    return params.handle;
+}
+
+UINT CDECL wine_date_picker_result(UINT64 handle, UINT *date)
+{
+    struct date_picker_result_params params = { .handle = handle };
+
+    MACDRV_CALL(date_picker_result, &params);
+    *date = params.date;
+    return params.status;
+}
+
+void CDECL wine_date_picker_close(UINT64 handle)
+{
+    struct date_picker_close_params params = { .handle = handle };
+    MACDRV_CALL(date_picker_close, &params);
+}
+
 

+#define DATETIME_MAC_TIMER 0x4d43
+#define MAC_DATE_PICKER_OK 1
+#define MAC_DATE_PICKER_PENDING 0
+
+static UINT64 (CDECL *mac_picker_show)(HWND, UINT, UINT, UINT);
+static UINT (CDECL *mac_picker_result)(UINT64, UINT *);
+static void (CDECL *mac_picker_close)(UINT64);
+
+static BOOL DATETIME_GetMacCalendarFuncs(void)
+{
+    HMODULE module;
+    WCHAR env[8];
+
+    if (mac_picker_show) return TRUE;
+    if (GetEnvironmentVariableW(L"WINE_MAC_DATE_PICKER", env, ARRAY_SIZE(env)) && !wcscmp(env, L"0"))
+        return FALSE;
+    if (!(module = GetModuleHandleW(L"winemac.drv"))) return FALSE;
+
+    mac_picker_result = (void *)GetProcAddress(module, "wine_date_picker_result");
+    mac_picker_close = (void *)GetProcAddress(module, "wine_date_picker_close");
+    if (!mac_picker_result || !mac_picker_close) return FALSE;
+    mac_picker_show = (void *)GetProcAddress(module, "wine_date_picker_show");
+    return mac_picker_show != NULL;
+}
+
+static UINT DATETIME_DateToYmd(const SYSTEMTIME *date)
+{
+    return date->wYear * 10000 + date->wMonth * 100 + date->wDay;
+}
+
+/* Applies the day picked in the Mac popover, or on dismiss closes a popover that is still open */
+static LRESULT DATETIME_PollMacCalendar(DATETIME_INFO *infoPtr, BOOL dismiss)
+{
+    UINT date = 0, status = mac_picker_result(infoPtr->mac_picker, &date);
+
+    if (status == MAC_DATE_PICKER_PENDING && !dismiss) return 0;
+
+    KillTimer(infoPtr->hwndSelf, DATETIME_MAC_TIMER);
+    mac_picker_close(infoPtr->mac_picker);
+    infoPtr->mac_picker = 0;
+
+    if (status == MAC_DATE_PICKER_OK && date)
+    {
+        infoPtr->date.wYear = date / 10000;
+        infoPtr->date.wMonth = date / 100 % 100;
+        infoPtr->date.wDay = date % 100;
+        MONTHCAL_CalculateDayOfWeek(&infoPtr->date, TRUE);
+        infoPtr->dateValid = TRUE;
+        SendMessageW(infoPtr->hwndCheckbut, BM_SETCHECK, BST_CHECKED, 0);
+        InvalidateRect(infoPtr->hwndSelf, NULL, TRUE);
+        DATETIME_SendDateTimeChangeNotify(infoPtr);
+    }
+    else
+        infoPtr->mac_closed_tick = GetTickCount();
+
+    DATETIME_SendSimpleNotify(infoPtr, DTN_CLOSEUP);
+    return 0;
+}
+
+/* Opens the native macOS calendar popover instead of the month calendar; returns FALSE to fall back to the month calendar */
+static BOOL DATETIME_ShowMacCalendar(DATETIME_INFO *infoPtr)
+{
+    SYSTEMTIME range[2];
+    UINT min_date = 0, max_date = 0;
+    DWORD limits;
+
+    if (infoPtr->mac_picker)
+    {
+        DATETIME_PollMacCalendar(infoPtr, TRUE);
+        return TRUE;
+    }
+    /* The click that dismissed the popover must not open it again */
+    if (GetTickCount() - infoPtr->mac_closed_tick < 300) return TRUE;
+
+    if (!DATETIME_GetMacCalendarFuncs()) return FALSE;
+    if (GetWindowLongW(infoPtr->hMonthCal, GWL_STYLE) & (MCS_MULTISELECT | MCS_WEEKNUMBERS | MCS_DAYSTATE))
+        return FALSE;
+
+    DATETIME_SendSimpleNotify(infoPtr, DTN_DROPDOWN);
+
+    limits = SendMessageW(infoPtr->hMonthCal, MCM_GETRANGE, 0, (LPARAM)range);
+    if (limits & GDTR_MIN) min_date = DATETIME_DateToYmd(&range[0]);
+    if (limits & GDTR_MAX) max_date = DATETIME_DateToYmd(&range[1]);
+
+    infoPtr->mac_picker = mac_picker_show(infoPtr->hwndSelf, DATETIME_DateToYmd(&infoPtr->date), min_date, max_date);
+    if (infoPtr->mac_picker)
+        SetTimer(infoPtr->hwndSelf, DATETIME_MAC_TIMER, 50, NULL);
+    else
+        ShowWindow(infoPtr->hMonthCal, SW_SHOW);
+    return TRUE;
+}

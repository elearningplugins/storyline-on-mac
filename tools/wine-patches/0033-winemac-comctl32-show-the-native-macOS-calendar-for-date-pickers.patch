+static NTSTATUS macdrv_date_picker_start_call(void *arg)
+{
+    struct date_picker_start_params *params = arg;
+    HWND hwnd = (HWND)(UINT_PTR)params->hwnd;
+    RECT rect;
+    macdrv_window window = macdrv_get_cocoa_window(NtUserGetAncestor(hwnd, GA_ROOT), TRUE);
+
+    params->handle = 0;
+    if (!window) return STATUS_UNSUCCESSFUL;
+    if (!NtUserGetWindowRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))) return STATUS_UNSUCCESSFUL;
+    params->handle = (UINT_PTR)macdrv_date_picker_start(window, cgrect_mac_from_win(cgrect_from_rect(rect)),
+                                                        params->date, params->min_date, params->max_date);
+    return params->handle ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+}
+
+static NTSTATUS macdrv_date_picker_result_call(void *arg)
+{
+    struct date_picker_result_params *params = arg;
+    macdrv_date_picker picker = param_ptr(params->handle);
+
+    params->status = macdrv_date_picker_status(picker);
+    params->date = params->status == MACDRV_DATE_PICKER_OK ? macdrv_date_picker_result(picker) : 0;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS macdrv_date_picker_close_call(void *arg)
+{
+    struct date_picker_close_params *params = arg;
+    macdrv_date_picker_close(param_ptr(params->handle));
+    return STATUS_SUCCESS;
+}

diff --git a/dlls/winemac.drv/cocoa_datepicker.m b/dlls/winemac.drv/cocoa_datepicker.m
new file mode 100644
--- /dev/null
+++ b/dlls/winemac.drv/cocoa_datepicker.m
@@ -0,0 +1,243 @@
+/* MACDRV Cocoa calendar popover for date picker controls; LGPL 2.1 or later, like the rest of Wine */
+
+#import <AppKit/AppKit.h>
+#include "macdrv_cocoa.h"
+#import "cocoa_app.h"
+#import "cocoa_window.h"
+
+
+@class WineDatePicker;
+
+@interface WineDatePickerView : NSDatePicker
+{
+@public
+    WineDatePicker* owner;
+}
+@end
+
+@interface WineDatePicker : NSObject <NSPopoverDelegate>
+{
+@public
+    WineWindow* window;
+    CGRect rect;
+    unsigned int date;
+    unsigned int minDate;
+    unsigned int maxDate;
+    NSPopover* popover;
+    WineDatePickerView* pickerView;
+    unsigned int result;
+    int status;
+}
+- (void) finish:(int)newStatus;
+@end
+
+
+static NSCalendar* utc_calendar(void)
+{
+    NSCalendar* calendar = [[[NSCalendar alloc] initWithCalendarIdentifier:NSCalendarIdentifierGregorian] autorelease];
+    calendar.timeZone = [NSTimeZone timeZoneForSecondsFromGMT:0];
+    return calendar;
+}
+
+static NSDate* date_from_ymd(NSCalendar* calendar, unsigned int ymd)
+{
+    NSDateComponents* components;
+
+    if (!ymd) return nil;
+    components = [[[NSDateComponents alloc] init] autorelease];
+    components.year = ymd / 10000;
+    components.month = ymd / 100 % 100;
+    components.day = ymd % 100;
+    components.hour = 12;
+    return [calendar dateFromComponents:components];
+}
+
+static unsigned int ymd_from_date(NSCalendar* calendar, NSDate* value)
+{
+    NSDateComponents* components;
+
+    if (!value) return 0;
+    components = [calendar components:NSCalendarUnitYear | NSCalendarUnitMonth | NSCalendarUnitDay fromDate:value];
+    return components.year * 10000 + components.month * 100 + components.day;
+}
+
+
+@implementation WineDatePickerView
+
+    /* A click on a day of the shown month picks it; clicks on the header only change the month, so they keep the popover open */
+    - (void) mouseDown:(NSEvent*)event
+    {
+        NSCalendar* calendar = utc_calendar();
+        unsigned int before = ymd_from_date(calendar, self.dateValue), after;
+        NSPoint point = [self convertPoint:event.locationInWindow fromView:nil];
+        CGFloat fromTop = self.isFlipped ? point.y : NSHeight(self.bounds) - point.y;
+
+        [super mouseDown:event];
+
+        after = ymd_from_date(calendar, self.dateValue);
+        if (owner && before / 100 == after / 100 && (before != after || fromTop > NSHeight(self.bounds) / 4))
+        {
+            owner->result = after;
+            [owner finish:MACDRV_DATE_PICKER_OK];
+        }
+    }
+
+    - (void) keyDown:(NSEvent*)event
+    {
+        NSString* chars = event.charactersIgnoringModifiers;
+        unichar c = chars.length ? [chars characterAtIndex:0] : 0;
+
+        if (!owner)
+            [super keyDown:event];
+        else if (c == '\r' || c == 3)
+        {
+            owner->result = ymd_from_date(utc_calendar(), self.dateValue);
+            [owner finish:MACDRV_DATE_PICKER_OK];
+        }
+        else if (c == 27)
+            [owner finish:MACDRV_DATE_PICKER_CANCEL];
+        else
+            [super keyDown:event];
+    }
+
+    - (void) cancelOperation:(id)sender
+    {
+        [owner finish:MACDRV_DATE_PICKER_CANCEL];
+    }
+
+    - (BOOL) acceptsFirstResponder
+    {
+        return YES;
+    }
+
+@end
+
+
+@implementation WineDatePicker
+
+    - (void) dealloc
+    {
+        [window release];
+        [popover release];
+        [pickerView release];
+        [super dealloc];
+    }
+
+    - (void) finish:(int)newStatus
+    {
+        if (__atomic_load_n(&status, __ATOMIC_ACQUIRE) != MACDRV_DATE_PICKER_PENDING) return;
+        __atomic_store_n(&status, newStatus, __ATOMIC_RELEASE);
+        if (popover.shown) [popover close];
+    }
+
+    - (void) show
+    {
+        NSCalendar* calendar = utc_calendar();
+        NSView* view = window.contentView;
+        NSViewController* controller;
+        NSView* container;
+        NSRect anchor = NSRectFromCGRect(rect);
+        NSSize size;
+        const CGFloat margin = 8;
+
+        if (!view || !window.visible)
+        {
+            [self finish:MACDRV_DATE_PICKER_CANCEL];
+            return;
+        }
+
+        pickerView = [[WineDatePickerView alloc] initWithFrame:NSZeroRect];
+        pickerView->owner = self;
+        pickerView.calendar = calendar;
+        pickerView.timeZone = calendar.timeZone;
+        pickerView.datePickerStyle = NSDatePickerStyleClockAndCalendar;
+        pickerView.datePickerElements = NSDatePickerElementFlagYearMonthDay;
+        pickerView.datePickerMode = NSDatePickerModeSingle;
+        pickerView.bezeled = NO;
+        pickerView.bordered = NO;
+        pickerView.drawsBackground = NO;
+        pickerView.focusRingType = NSFocusRingTypeNone;
+        pickerView.minDate = date_from_ymd(calendar, minDate);
+        pickerView.maxDate = date_from_ymd(calendar, maxDate);
+        pickerView.dateValue = date_from_ymd(calendar, date) ?: [NSDate date];
+        [pickerView sizeToFit];
+        size = pickerView.frame.size;
+
+        container = [[[NSView alloc] initWithFrame:NSMakeRect(0, 0, size.width + 2 * margin, size.height + 2 * margin)] autorelease];
+        [pickerView setFrameOrigin:NSMakePoint(margin, margin)];
+        [container addSubview:pickerView];
+
+        controller = [[[NSViewController alloc] init] autorelease];
+        controller.view = container;
+
+        popover = [[NSPopover alloc] init];
+        popover.contentViewController = controller;
+        popover.contentSize = container.frame.size;
+        popover.behavior = NSPopoverBehaviorTransient;
+        popover.animates = NO;
+        popover.delegate = self;
+
+        [[WineApplicationController sharedController] flipRect:&anchor];
+        anchor = [window convertRectFromScreen:anchor];
+        anchor = [view convertRect:anchor fromView:nil];
+
+        [popover showRelativeToRect:anchor ofView:view preferredEdge:view.isFlipped ? NSRectEdgeMaxY : NSRectEdgeMinY];
+        [pickerView.window makeFirstResponder:pickerView];
+    }
+
+    - (void) popoverDidClose:(NSNotification*)notification
+    {
+        [self finish:MACDRV_DATE_PICKER_CANCEL];
+    }
+
+@end
+
+
+/* rect is the date picker control in Mac global coordinates; the popover opens below it and stays until a day is picked or it is dismissed */
+macdrv_date_picker macdrv_date_picker_start(macdrv_window w, CGRect rect, unsigned int date,
+                                            unsigned int min_date, unsigned int max_date)
+{
+    WineDatePicker* dp = [[WineDatePicker alloc] init];
+
+    dp->window = [(WineWindow*)w retain];
+    dp->rect = rect;
+    dp->date = date;
+    dp->minDate = min_date;
+    dp->maxDate = max_date;
+
+    [dp retain];
+    OnMainThreadAsync(^{
+        @autoreleasepool
+        {
+            [dp show];
+        }
+        [dp release];
+    });
+
+    return (macdrv_date_picker)dp;
+}
+
+int macdrv_date_picker_status(macdrv_date_picker p)
+{
+    WineDatePicker* dp = (WineDatePicker*)p;
+    return __atomic_load_n(&dp->status, __ATOMIC_ACQUIRE);
+}
+
+unsigned int macdrv_date_picker_result(macdrv_date_picker p)
+{
+    WineDatePicker* dp = (WineDatePicker*)p;
+    return macdrv_date_picker_status(p) == MACDRV_DATE_PICKER_OK ? dp->result : 0;
+}
+
+/* Closes the popover if it is still open and releases it */
+void macdrv_date_picker_close(macdrv_date_picker p)
+{
+    WineDatePicker* dp = (WineDatePicker*)p;
+
+    OnMainThreadAsync(^{
+        [dp finish:MACDRV_DATE_PICKER_CANCEL];
+        dp->popover.delegate = nil;
+        if (dp->pickerView) dp->pickerView->owner = nil;
+        [dp release];
+    });
+}

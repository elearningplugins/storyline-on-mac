 #include "unix_private.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(file);
+
+/** WINE_PERF_LOG=1: per-second totals of file lookups by thread and folder, at most FSPERF_TOP lines per kind per second. */
+#define FSPERF_SLOTS 256
+#define FSPERF_TOP 8
+struct fsperf_slot { char kind; unsigned int tid, n, fails; ULONGLONG us; char dir[200]; char example[64]; };
+static struct fsperf_slot fsperf_tab[FSPERF_SLOTS];
+static unsigned int fsperf_used;
+static ULONGLONG fsperf_window;
+static pthread_mutex_t fsperf_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static BOOL fsperf_enabled(void)
+{
+    static int enabled = -1;
+    const char *value;
+    if (enabled < 0) enabled = (value = getenv( "WINE_PERF_LOG" )) && *value && *value != '0';
+    return enabled;
+}
+
+static ULONGLONG fsperf_now(void)
+{
+    LARGE_INTEGER counter, freq;
+    NtQueryPerformanceCounter( &counter, &freq );
+    return counter.QuadPart / (freq.QuadPart / 1000000);
+}
+
+static void fsperf_print_path( char *out, size_t size, const char *in )
+{
+    size_t i = 0;
+    for (; *in && i + 4 < size; in++)
+    {
+        if (*in == ' ' || *in == '%') i += snprintf( out + i, size - i, "%%%02X", (unsigned char)*in );
+        else out[i++] = *in;
+    }
+    out[i] = 0;
+}
+
+static int fsperf_cmp( const void *a, const void *b )
+{
+    const struct fsperf_slot *x = a, *y = b;
+    if (x->kind != y->kind) return x->kind - y->kind;
+    return x->us < y->us ? 1 : x->us > y->us ? -1 : 0;
+}
+
+static void fsperf_flush( ULONGLONG now )
+{
+    char dir[400], example[160];
+    unsigned int i, shown = 0, pid = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+    char kind = 0;
+
+    qsort( fsperf_tab, fsperf_used, sizeof(fsperf_tab[0]), fsperf_cmp );
+    for (i = 0; i < fsperf_used; i++)
+    {
+        struct fsperf_slot *s = &fsperf_tab[i];
+        if (s->kind != kind) { kind = s->kind; shown = 0; }
+        if (shown++ >= FSPERF_TOP) continue;
+        fsperf_print_path( dir, sizeof(dir), s->dir );
+        fsperf_print_path( example, sizeof(example), s->example );
+        fprintf( stderr, "perf %u.%06u %04x %04x ntdll fs kind=%s tid=%04x n=%u fails=%u us=%llu ex=%s dir=%s\n",
+                 (unsigned int)(now / 1000000), (unsigned int)(now % 1000000), pid, s->tid,
+                 s->kind == 'd' ? "list" : s->kind == 'a' ? "attr" : "open", s->tid, s->n, s->fails,
+                 (unsigned long long)s->us, example, dir );
+    }
+    fsperf_used = 0;
+    fsperf_window = now;
+}
+
+/* kind: 'd' directory listing (path is the directory), 'a' attribute query, 'o' open (path is the file) */
+static void fsperf_record( char kind, const char *path, ULONGLONG start, BOOL failed )
+{
+    ULONGLONG now = fsperf_now();
+    unsigned int i, tid = HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+    char dir[200];
+    const char *base = path, *slash;
+
+    if (kind != 'd' && (slash = strrchr( path, '/' )))
+    {
+        snprintf( dir, sizeof(dir), "%.*s", (int)(slash - path), path );
+        base = slash + 1;
+    }
+    else
+    {
+        snprintf( dir, sizeof(dir), "%s", path );
+        base = "-";
+    }
+
+    mutex_lock( &fsperf_mutex );
+    if (!fsperf_window) fsperf_window = now;
+    for (i = 0; i < fsperf_used; i++)
+        if (fsperf_tab[i].kind == kind && fsperf_tab[i].tid == tid && !strcmp( fsperf_tab[i].dir, dir )) break;
+    if (i == fsperf_used && fsperf_used < FSPERF_SLOTS)
+    {
+        memset( &fsperf_tab[i], 0, sizeof(fsperf_tab[i]) );
+        fsperf_tab[i].kind = kind;
+        fsperf_tab[i].tid = tid;
+        snprintf( fsperf_tab[i].dir, sizeof(fsperf_tab[i].dir), "%s", dir );
+        fsperf_used++;
+    }
+    if (i < fsperf_used)
+    {
+        fsperf_tab[i].n++;
+        fsperf_tab[i].us += now - start;
+        if (failed) fsperf_tab[i].fails++;
+        snprintf( fsperf_tab[i].example, sizeof(fsperf_tab[i].example), "%s", base );
+    }
+    if (now - fsperf_window >= 1000000) fsperf_flush( now );
+    mutex_unlock( &fsperf_mutex );
+}
+
+static void fsperf_record_nt( char kind, const UNICODE_STRING *name, const char *unix_name, ULONGLONG start, BOOL failed )
+{
+    char buf[400];
+    unsigned int i, len;
+
+    if (unix_name) { fsperf_record( kind, unix_name, start, failed ); return; }
+    len = name ? min( name->Length / sizeof(WCHAR), sizeof(buf) - 1 ) : 0;
+    for (i = 0; i < len; i++) buf[i] = name->Buffer[i] == '\\' ? '/' : name->Buffer[i] < 0x80 ? name->Buffer[i] : '?';
+    buf[len] = 0;
+    fsperf_record( kind, buf, start, failed );
+}
 WINE_DECLARE_DEBUG_CHANNEL(winediag);
 
